# Local development defaults. These are not production secrets.
# Copy this file to .env and replace every value before any shared or production deployment.

DATABASE_URL=postgresql://pesowise:pesowise_dev_password@localhost:5432/pesowise
DATABASE_URL_TEST=postgresql://pesowise:pesowise_dev_password@localhost:5432/pesowise_test
SESSION_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
COOKIE_SECURE=false

# Set EMBEDDED_POSTGRES=false when you already run PostgreSQL, including Docker Compose.
EMBEDDED_POSTGRES=true

# Used by the Vercel cron that generates due recurring transactions. Leave unset locally.
# CRON_SECRET=replace-with-another-long-random-string
