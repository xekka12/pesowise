{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "framework": "express",
  "functions": {
    "app.ts": {
      "includeFiles": "client/dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/recurring",
      "schedule": "0 16 * * *"
    }
  ]
}
